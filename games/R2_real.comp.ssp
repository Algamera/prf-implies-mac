composition R2_real {
    const n: Integer;
    const prf: fn Bits(n), Bits(n) -> Bits(n);

    instance prf_real = Prf_real {
        params {
            n: n,
            prf: prf,
        }
    }

    instance reduc = R2 {
        params {
            n: n,
        }
    }

    compose {
        adversary: {
            Mac: reduc,
            Verify: reduc,
        },
        reduc: {
            Eval: prf_real,
        },
    }
}