theorem Proof {
    const n: Integer;
    const prf: fn Bits(n), Bits(n) -> Bits(n);

    instance mac_real = MAC_real_comp {
        params {
            n: n, 
            prf: prf,
        }
    }

    instance r1_real = R1_real {
        params {
            n: n,
            prf: prf,
        }
    }
    instance r1_ideal = R1_ideal {
        params {
            n: n,
            prf: prf,
        }
    }

    instance prf_real_game = PRF_real_comp {
        params {
            n: n,
            prf: prf,
        }
    }

    instance prf_ideal_game = PRF_ideal_comp {
        params {
            n: n,
        }
    }

    instance r2_real = R2_real {
        params {
            n: n,
            prf: prf,
        }
    }

    instance r2_ideal = R2_ideal {
        params {
            n: n,
        }
    }

    assumptions {
        PRFSecurity: prf_real_game ~ prf_ideal_game
    }

    gamehops {
        equivalence mac_real r1_real {
            invariant: [./theorem/invariant.smt2]

            Mac: {
                randomness: custom

                lemmas {
                    equal-aborts: []
                    invariant: [no-abort]
                    same-output: [no-abort]
                }
            }
            Verify: {
                randomness: custom

                lemmas {
                    equal-aborts: []
                    invariant: [no-abort]
                    same-output: [no-abort]
                }
            }
        }

        reduction r1_real r1_ideal {
            assumption PRFSecurity

            map prf_real_game r1_real {
                prf_real: prf_real
            }

            map prf_ideal_game r1_ideal {
                prf_ideal: prf_ideal
            }
        }

        reduction r2_real r2_ideal {
            assumption PRFSecurity

            map prf_real_game r2_real {
                prf_real: prf_real
            }

            map prf_ideal_game r2_ideal {
                prf_ideal: prf_ideal
            }
        }
    }


}